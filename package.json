{
  "name": "switch-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "generate:ios-startup": "node scripts/generate-ios-startup-images.mjs",
    "generate:native-splash": "node scripts/generate-native-splash.mjs",
    "generate:app-icons": "node scripts/generate-app-icons.mjs",
    "generate:sensory-sounds": "node scripts/generate-sensory-sounds.mjs",
    "clean:logo": "node scripts/clean-switch-it-logo.mjs",
    "test:watch": "vitest",
    "sync:maplibre-worker": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/ && cp node_modules/@mapbox/mapbox-gl-rtl-text/dist/mapbox-gl-rtl-text.js public/maplibre/",
    "native:sync": "npx cap sync",
    "native:sync:ios": "npx cap sync ios",
    "native:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@mapbox/mapbox-gl-rtl-text": "^0.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@switch-it/handoff-background-location": "file:native/handoff-background-location",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.1.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
